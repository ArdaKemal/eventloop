# Copy to stonegate.toml and create public/ beside it.
# Split sites into exact include paths if desired:
# include = ["sites/docs.toml", "sites/downloads.toml"]

[runtime]
shutdown_seconds = 5
workers = 1                 # Event-loop threads serving every listener.
worker_mode = "auto"        # reuse_port on Linux, handoff elsewhere.

# Every server inherits these settings. Explicit server fields override them.
[defaults]
bind = "127.0.0.1"          # Use "0.0.0.0" to listen on every IPv4 interface.
directory_listing = false
reuse_port = false
open_file_cache_capacity = 0 # Each cached file holds a descriptor per listener.
header_timeout_ms = 30_000
idle_timeout_ms = 60_000

[defaults.http]
mode = "serve"             # "serve", "redirect", or "off"
port = 8080
redirect_host = "localhost"

[defaults.tls]
port = 8443                # 0 disables TCP TLS; credentials enable it otherwise.
http2 = true

[defaults.http3]
port = 0                   # UDP; may share a port number with TCP TLS.
connections = 8            # 1..256 per server
requests = 0               # 0 selects ten scratch slots per connection.
max_datagram = 8192         # 1200..8192 bytes

[[server]]
name = "public"
root = "public"

# Enable HTTPS by supplying both files, resolved beside this TOML file:
# [server.tls]
# certificate = "certs/fullchain.pem"
# private_key = "certs/privkey.pem"
# key_password = ""         # HTTP/3 requires an unencrypted key.
#
# Redirect HTTP to TLS and enable HTTP/3:
# [server.http]
# mode = "redirect"
# redirect_host = "example.com"
# [server.http3]
# port = 8443

# A second site on its own endpoint (does not match Host/SNI):
# [[server]]
# name = "downloads"
# root = "downloads"
# directory_listing = true
# [server.http]
# port = 8081
