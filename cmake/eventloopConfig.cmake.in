@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@EVENTLOOP_CONFIG_NEEDS_BOTAN@)
    find_dependency(Botan 3)
endif()
if(@EVENTLOOP_CONFIG_NEEDS_OPENSSL@)
    find_dependency(OpenSSL 3.5 COMPONENTS Crypto SSL)
endif()
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/eventloopTargets.cmake")
check_required_components(eventloop)
